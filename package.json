{
  "name": "konverter-ui",
  "version": "1.0.0",
  "private": true,
  "description": "Build pipeline Tailwind CSS untuk UI Flask dan Streamlit.",
  "scripts": {
    "build:css:flask": "tailwindcss -i flask_app/static/css/tailwind.src.css -o flask_app/static/css/tailwind.css --minify",
    "build:css:streamlit": "tailwindcss -i flask_app/static/css/tailwind.streamlit.src.css -o flask_app/static/css/tailwind-streamlit.css --minify",
    "build:css": "npm run build:css:flask && npm run build:css:streamlit",
    "watch:css:flask": "tailwindcss -i flask_app/static/css/tailwind.src.css -o flask_app/static/css/tailwind.css --watch",
    "watch:css:streamlit": "tailwindcss -i flask_app/static/css/tailwind.streamlit.src.css -o flask_app/static/css/tailwind-streamlit.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.11",
    "tailwindcss": "^4.1.11"
  }
}
