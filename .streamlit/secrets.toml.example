# Salin file ini menjadi .streamlit/secrets.toml (sudah di-.gitignore).
# Untuk Streamlit Community Cloud: App settings -> Secrets -> tempel isi yang sama.
#
# Aplikasi bisa memakai SALAH SATU backend akun (Supabase atau Appwrite).
# Backend aktif diatur di bagian [app] paling bawah. Bila tidak ada backend
# yang dikonfigurasi, aplikasi tetap jalan dalam mode tamu (10 MB, tanpa riwayat).
#
# Untuk menjalankan dua app sekaligus (production + staging) dengan backend
# berbeda, isi Secrets masing-masing app secara terpisah (lihat README ->
# "Dua deployment (production + staging) dengan backend berbeda").

# =============================================================================
# Opsi A: Supabase (Auth + Postgres + Storage)
# =============================================================================
# Ambil dari Supabase Dashboard -> Project Settings -> API:
#   Project URL  -> url
#   anon public  -> anon_key   (aman dipakai di klien; RLS yang melindungi data)
# Jangan pernah menaruh "service_role" key di sini untuk aplikasi ini.
# Jalankan supabase/schema.sql lebih dulu agar tabel jobs & bucket tersedia.
[supabase]
url = "https://<project-ref>.supabase.co"
anon_key = "<anon-public-key>"

# =============================================================================
# Opsi B: Appwrite (Auth + TablesDB + Storage)
# =============================================================================
# Ambil dari Appwrite Console -> Project Settings:
#   API endpoint -> endpoint (mis. https://sgp.cloud.appwrite.io/v1)
#   Project ID   -> project_id
# Siapkan database/table/bucket otomatis dengan:
#   python scripts/appwrite_setup.py --api-key <API_KEY_SEKALI_PAKAI>
# API key hanya untuk setup; JANGAN ditaruh di file ini.
[appwrite]
endpoint = "https://<region>.cloud.appwrite.io/v1"
project_id = "<project-id>"
database_id = "konverter"
jobs_table_id = "jobs"
sources_bucket_id = "sources"
results_bucket_id = "sources"

# =============================================================================
# Backend aktif: "supabase", "appwrite", atau "auto" (default)
# "auto" memilih Supabase bila siap, jika tidak Appwrite.
# =============================================================================
[app]
backend = "auto"

# =============================================================================
# Opsional: koneksi database langsung (Session pooler) untuk Flask/Docker
# =============================================================================
# Gunakan connection string "Session pooler" dari Supabase
# (Dashboard -> Connect -> Connection pooling -> Session mode), bukan direct
# connection, karena host db.<ref>.supabase.co hanya IPv6.
[connections.db]
url = "postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# Untuk Flask/Docker, set env var DATABASE_URL dengan nilai URL yang sama.
